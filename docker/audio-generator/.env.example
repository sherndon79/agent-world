# AI Model API Keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
MUBERT_API_KEY=your_mubert_api_key_here
STABILITY_API_KEY=your_stability_ai_api_key_here

# Redis Story State Connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CHANNEL=story_state

# Audio Model Selection
NARRATION_MODEL=chatterbox  # chatterbox (self-hosted) or elevenlabs (API)
AMBIENT_MODEL=elevenlabs    # elevenlabs or stable-audio
MUSIC_MODEL=mubert          # mubert or stable-audio
COMMENTARY_MODEL=elevenlabs # elevenlabs or live-mic

# Audio Output Configuration
NARRATION_PORT=9001
AMBIENT_PORT=9002
MUSIC_PORT=9003
COMMENTARY_PORT=9004

# Audio Quality Settings
SAMPLE_RATE=48000
BITRATE=160000  # 160kbps for narration/commentary
MUSIC_BITRATE=128000  # 128kbps for ambient/music
CHANNELS=2  # stereo

# SRT Streaming Settings
SRT_LATENCY=200  # ms
SRT_MODE=caller  # caller (container) / listener (OBS)

# Logging
LOG_LEVEL=INFO
